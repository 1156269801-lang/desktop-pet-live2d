<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="大肥鱼桌宠 · 启动器"
        Height="660" Width="1000" MinHeight="560" MinWidth="860"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

  <Window.Resources>
    <SolidColorBrush x:Key="B.Bg" Color="#F4F7FA" />
    <SolidColorBrush x:Key="B.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="B.Surface2" Color="#EEF3F8" />
    <SolidColorBrush x:Key="B.Sidebar" Color="#2B3440" />
    <SolidColorBrush x:Key="B.SidebarHi" Color="#353F4D" />
    <SolidColorBrush x:Key="B.Text" Color="#16243A" />
    <SolidColorBrush x:Key="B.Muted" Color="#5A6B80" />
    <SolidColorBrush x:Key="B.Faint" Color="#65758A" />
    <SolidColorBrush x:Key="B.Accent" Color="#1A63C4" />
    <SolidColorBrush x:Key="B.Border" Color="#D8E2EC" />
    <SolidColorBrush x:Key="B.Ok" Color="#0F7A36" />
    <SolidColorBrush x:Key="B.Warn" Color="#B45309" />
    <SolidColorBrush x:Key="B.Bad" Color="#DC2626" />

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="9" Padding="22,11">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#2E82EF" Offset="0" />
                  <GradientStop Color="#1A63C4" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.28" Color="#0B2A5E" />
              </Border.Effect>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.92" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.82" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.42" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource B.Text}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" CornerRadius="8" BorderThickness="1"
                    BorderBrush="{StaticResource B.Border}"
                    Background="{StaticResource B.Surface2}"
                    Padding="18,9">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="White" />
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Accent}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
      <Setter Property="Foreground" Value="{StaticResource B.Bad}" />
    </Style>

    <Style x:Key="NavItem" TargetType="Button">
      <Setter Property="Foreground" Value="#E8EEF5" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Height" Value="38" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="bg" Background="Transparent" CornerRadius="6" Margin="8,2" />
              <Border x:Name="bar" Width="3" HorizontalAlignment="Left" CornerRadius="2"
                      Background="{StaticResource B.Accent}" Margin="0,9" Visibility="Collapsed" />
              <ContentPresenter Margin="24,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="{StaticResource B.SidebarHi}" />
              </Trigger>
              <Trigger Property="Tag" Value="active">
                <Setter TargetName="bg" Property="Background" Value="{StaticResource B.SidebarHi}" />
                <Setter TargetName="bar" Property="Visibility" Value="Visible" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource B.Surface}" />
      <Setter Property="BorderBrush" Value="{StaticResource B.Border}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.07" Color="#0B2A5E" />
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TitleButton" TargetType="Button">
      <Setter Property="Foreground" Value="#9AA9BA" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="Transparent" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#3A4552" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 输入框 -->
    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Background" Value="{StaticResource B.Surface2}" />
      <Setter Property="Foreground" Value="{StaticResource B.Text}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="bd" CornerRadius="7" Background="{TemplateBinding Background}"
                    BorderThickness="1" BorderBrush="Transparent">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource B.Accent}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="FieldCaption" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{StaticResource B.Muted}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource B.Text}" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource B.Text}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <Border x:Name="Shell" CornerRadius="12" Background="{StaticResource B.Bg}" Margin="12">
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.3" Color="#0B2A5E" />
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="64" />
        <RowDefinition Height="*" />
        <RowDefinition Height="38" />
      </Grid.RowDefinitions>

      <!-- ===== 标题栏 ===== -->
      <Border x:Name="TitleBar" Grid.Row="0" Background="{StaticResource B.Sidebar}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
            <TextBlock x:Name="AppTitle" Text="大肥鱼桌宠" FontSize="17" FontWeight="SemiBold"
                       Foreground="White" VerticalAlignment="Center" />
            <TextBlock x:Name="AppVersion" Text=" v1.1.1" FontSize="12"
                       Foreground="#9AA9BA" VerticalAlignment="Center" Margin="2,2,0,0" />
            <Border Width="1" Height="18" Background="#3A4552" Margin="18,0" />
            <TextBlock x:Name="BuildLabel" Text="Launcher v1.1.1" FontSize="11"
                       Foreground="#8FA0B4" VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="RuntimeDot" Width="8" Height="8" Fill="{StaticResource B.Ok}"
                     VerticalAlignment="Center" Margin="0,0,7,0">
              <Ellipse.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                  <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                      <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                       From="0.4" To="1" Duration="0:0:1.2" />
                    </Storyboard>
                  </BeginStoryboard>
                </EventTrigger>
              </Ellipse.Triggers>
            </Ellipse>
            <TextBlock x:Name="RuntimeText" Text="运行时检测中" FontSize="11.5"
                       Foreground="#9AA9BA" VerticalAlignment="Center" Margin="0,0,16,0" />
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
            <Button x:Name="BtnMin" Content="&#xE921;" Style="{StaticResource TitleButton}"
                    FontFamily="Segoe MDL2 Assets" FontSize="10" />
            <Button x:Name="BtnClose" Content="&#xE8BB;" Style="{StaticResource TitleButton}"
                    FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="4,0,0,0" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- ===== 主体 ===== -->
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="200" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource B.Sidebar}">
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="14,14,14,12">
              <Border Width="42" Height="42" CornerRadius="21" Background="#233040">
                <Image x:Name="BrandLogo" Stretch="Uniform" Margin="1" />
              </Border>
              <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                <TextBlock Text="大肥鱼桌宠" FontSize="12.5" FontWeight="SemiBold" Foreground="#E8EEF5" />
                <TextBlock x:Name="SideVersion" Text="v1.1.1" FontSize="10.5" Foreground="#8FA0B4" Margin="0,1,0,0" />
              </StackPanel>
            </StackPanel>
            <Border DockPanel.Dock="Top" Height="1" Background="#3A4552" Margin="14,2,14,8" />
            <StackPanel x:Name="NavPanel" DockPanel.Dock="Top" />
          </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="24,18,24,12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="PageTitle" Text="启动" FontSize="21" FontWeight="SemiBold"
                       Foreground="{StaticResource B.Text}" VerticalAlignment="Center" />
          </Grid>

          <!-- ===== 启动页 ===== -->
          <StackPanel x:Name="PageLaunch" Grid.Row="1">
            <Border Style="{StaticResource Card}" Padding="24,22">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="76" Height="76" CornerRadius="38" Background="{StaticResource B.Surface2}">
                  <Image x:Name="HeroLogo" Stretch="Uniform" Margin="2" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0">
                  <TextBlock Text="大肥鱼桌宠" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource B.Text}" />
                  <TextBlock x:Name="HeroVersion" Text="v1.1.1" FontSize="11.5"
                             Foreground="{StaticResource B.Accent}" Margin="0,3,0,0" />
                  <TextBlock Text="DeepSeek 鲸鱼娘 · Live2D 桌面宠物" FontSize="11.5"
                             Foreground="{StaticResource B.Muted}" Margin="0,5,0,0" />
                </StackPanel>
                <Button x:Name="BtnLaunch" Grid.Column="2" Content="▶  启动桌宠"
                        Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" />
              </Grid>
            </Border>

            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16,14" Margin="0,0,7,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border x:Name="BarTts" Grid.Column="0" CornerRadius="2" Background="{StaticResource B.Faint}" />
                  <Grid Grid.Column="1" Width="22" Height="22" Margin="12,0,0,0" VerticalAlignment="Top">
                    <Ellipse x:Name="GlowTts" Fill="{StaticResource B.Faint}" Opacity="0.22" />
                    <Ellipse x:Name="DotTts" Width="11" Height="11" Fill="{StaticResource B.Faint}" />
                  </Grid>
                  <StackPanel Grid.Column="2" Margin="10,0,0,0">
                    <TextBlock Text="TTS" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource B.Text}" />
                    <TextBlock x:Name="PortTts" Text="端口 9881" FontSize="10.5"
                               Foreground="{StaticResource B.Muted}" FontFamily="Consolas" Margin="0,4,0,0" />
                    <TextBlock x:Name="StateTts" Text="检测中" FontSize="10.5"
                               Foreground="{StaticResource B.Faint}" Margin="0,2,0,0" />
                  </StackPanel>
                </Grid>
              </Border>

              <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,14" Margin="7,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border x:Name="BarAsr" Grid.Column="0" CornerRadius="2" Background="{StaticResource B.Faint}" />
                  <Grid Grid.Column="1" Width="22" Height="22" Margin="12,0,0,0" VerticalAlignment="Top">
                    <Ellipse x:Name="GlowAsr" Fill="{StaticResource B.Faint}" Opacity="0.22" />
                    <Ellipse x:Name="DotAsr" Width="11" Height="11" Fill="{StaticResource B.Faint}" />
                  </Grid>
                  <StackPanel Grid.Column="2" Margin="10,0,0,0">
                    <TextBlock Text="ASR" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource B.Text}" />
                    <TextBlock x:Name="PortAsr" Text="端口 8000" FontSize="10.5"
                               Foreground="{StaticResource B.Muted}" FontFamily="Consolas" Margin="0,4,0,0" />
                    <TextBlock x:Name="StateAsr" Text="检测中" FontSize="10.5"
                               Foreground="{StaticResource B.Faint}" Margin="0,2,0,0" />
                  </StackPanel>
                </Grid>
              </Border>

              <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,14" Margin="7,0,0,0">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <Border x:Name="BarPet" Grid.Column="0" CornerRadius="2" Background="{StaticResource B.Faint}" />
                  <Grid Grid.Column="1" Width="22" Height="22" Margin="12,0,0,0" VerticalAlignment="Top">
                    <Ellipse x:Name="GlowPet" Fill="{StaticResource B.Faint}" Opacity="0.22" />
                    <Ellipse x:Name="DotPet" Width="11" Height="11" Fill="{StaticResource B.Faint}" />
                  </Grid>
                  <StackPanel Grid.Column="2" Margin="10,0,0,0">
                    <TextBlock Text="桌宠" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource B.Text}" />
                    <TextBlock x:Name="PortPet" Text="端口 41888" FontSize="10.5"
                               Foreground="{StaticResource B.Muted}" FontFamily="Consolas" Margin="0,4,0,0" />
                    <TextBlock x:Name="StatePet" Text="检测中" FontSize="10.5"
                               Foreground="{StaticResource B.Faint}" Margin="0,2,0,0" />
                  </StackPanel>
                </Grid>
              </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,14">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                  <TextBlock Text="最近日志" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource B.Text}" />
                  <TextBlock x:Name="LogFile" Text="" FontSize="10.5"
                             Foreground="{StaticResource B.Faint}" FontFamily="Consolas"
                             VerticalAlignment="Center" Margin="12,1,0,0" />
                </StackPanel>
                <Border Background="{StaticResource B.Surface2}" CornerRadius="7" Padding="12,9">
                  <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" MaxHeight="118">
                    <TextBlock x:Name="LogText" FontFamily="Consolas" FontSize="11"
                               Foreground="{StaticResource B.Muted}" TextWrapping="NoWrap" Text="等待日志…" />
                  </ScrollViewer>
                </Border>
              </DockPanel>
            </Border>
          </StackPanel>

          <!-- ===== 服务页 ===== -->
          <StackPanel x:Name="PageServices" Grid.Row="1" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="4" /><ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="SvcBarTts" Grid.Column="0" CornerRadius="2" Background="{StaticResource B.Faint}" />
                <Grid Grid.Column="1" Width="24" Height="24" Margin="12,0,0,0" VerticalAlignment="Top">
                  <Ellipse x:Name="SvcGlowTts" Fill="{StaticResource B.Faint}" Opacity="0.22" />
                  <Ellipse x:Name="SvcDotTts" Width="12" Height="12" Fill="{StaticResource B.Faint}" />
                </Grid>
                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                  <TextBlock Text="TTS · GPT-SoVITS" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource B.Text}" />
                  <TextBlock x:Name="SvcPortTts" Text="端口 9881" FontSize="10.5"
                             Foreground="{StaticResource B.Muted}" FontFamily="Consolas" Margin="0,4,0,0" />
                  <TextBlock x:Name="SvcStateTts" Text="检测中" FontSize="10.5"
                             Foreground="{StaticResource B.Faint}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button x:Name="SvcStartTts" Content="启动" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                  <Button x:Name="SvcStopTts" Content="停止" Style="{StaticResource DangerButton}" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="4" /><ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="SvcBarAsr" Grid.Column="0" CornerRadius="2" Background="{StaticResource B.Faint}" />
                <Grid Grid.Column="1" Width="24" Height="24" Margin="12,0,0,0" VerticalAlignment="Top">
                  <Ellipse x:Name="SvcGlowAsr" Fill="{StaticResource B.Faint}" Opacity="0.22" />
                  <Ellipse x:Name="SvcDotAsr" Width="12" Height="12" Fill="{StaticResource B.Faint}" />
                </Grid>
                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                  <TextBlock Text="ASR · SenseVoice" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource B.Text}" />
                  <TextBlock x:Name="SvcPortAsr" Text="端口 8000" FontSize="10.5"
                             Foreground="{StaticResource B.Muted}" FontFamily="Consolas" Margin="0,4,0,0" />
                  <TextBlock x:Name="SvcStateAsr" Text="检测中" FontSize="10.5"
                             Foreground="{StaticResource B.Faint}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button x:Name="SvcStartAsr" Content="启动" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                  <Button x:Name="SvcStopAsr" Content="停止" Style="{StaticResource DangerButton}" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20,16">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="4" /><ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="SvcBarPet" Grid.Column="0" CornerRadius="2" Background="{StaticResource B.Faint}" />
                <Grid Grid.Column="1" Width="24" Height="24" Margin="12,0,0,0" VerticalAlignment="Top">
                  <Ellipse x:Name="SvcGlowPet" Fill="{StaticResource B.Faint}" Opacity="0.22" />
                  <Ellipse x:Name="SvcDotPet" Width="12" Height="12" Fill="{StaticResource B.Faint}" />
                </Grid>
                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                  <TextBlock Text="桌宠 · Electron" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource B.Text}" />
                  <TextBlock x:Name="SvcPortPet" Text="端口 41888" FontSize="10.5"
                             Foreground="{StaticResource B.Muted}" FontFamily="Consolas" Margin="0,4,0,0" />
                  <TextBlock x:Name="SvcStatePet" Text="检测中" FontSize="10.5"
                             Foreground="{StaticResource B.Faint}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button x:Name="SvcStartPet" Content="启动" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                  <Button x:Name="SvcStopPet" Content="停止" Style="{StaticResource DangerButton}" />
                </StackPanel>
              </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,12,0,0">
              <StackPanel Orientation="Horizontal">
                <Button x:Name="SvcStopAll" Content="停止全部服务" Style="{StaticResource DangerButton}" Margin="0,0,10,0" />
                <Button x:Name="SvcRefresh" Content="刷新状态" Style="{StaticResource GhostButton}" />
                <TextBlock x:Name="SvcHint" Text="停止只会结束本启动器拉起的进程" FontSize="11"
                           Foreground="{StaticResource B.Faint}" VerticalAlignment="Center" Margin="14,0,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- ===== 设置页 ===== -->
          <ScrollViewer x:Name="PageSettings" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Border Style="{StaticResource Card}" Padding="20,18">
                <StackPanel>
                  <TextBlock Text="模型" Style="{StaticResource SectionTitle}" />
                  <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="服务地址" Style="{StaticResource FieldCaption}" />
                    <TextBox x:Name="SetBaseURL" Grid.Column="1" Style="{StaticResource Field}" />
                  </Grid>
                  <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="模型名称" Style="{StaticResource FieldCaption}" />
                    <TextBox x:Name="SetModel" Grid.Column="1" Style="{StaticResource Field}" />
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="API Key" Style="{StaticResource FieldCaption}" />
                    <TextBox x:Name="SetApiKey" Grid.Column="1" Style="{StaticResource Field}" />
                  </Grid>
                  <TextBlock Text="留空则读取环境变量里配置的凭据，不会写入明文"
                             FontSize="10.5" Foreground="{StaticResource B.Faint}" Margin="110,8,0,0" />
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,12,0,0">
                <StackPanel>
                  <TextBlock Text="端口" Style="{StaticResource SectionTitle}" />
                  <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="160" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="TTS 端口" Style="{StaticResource FieldCaption}" />
                    <TextBox x:Name="SetPortTts" Grid.Column="1" Style="{StaticResource Field}" FontFamily="Consolas" />
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="160" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ASR 端口" Style="{StaticResource FieldCaption}" />
                    <TextBox x:Name="SetPortAsr" Grid.Column="1" Style="{StaticResource Field}" FontFamily="Consolas" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="SetSave" Content="保存设置" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" />
                  <Button x:Name="SetReset" Content="恢复默认" Style="{StaticResource GhostButton}" />
                  <TextBlock x:Name="SetHint" Text="" FontSize="11"
                             Foreground="{StaticResource B.Faint}" VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- ===== 高级页 ===== -->
          <ScrollViewer x:Name="PageAdvanced" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Border Style="{StaticResource Card}" Padding="20,18">
                <StackPanel>
                  <TextBlock Text="统一人设" Style="{StaticResource SectionTitle}" />
                  <TextBox x:Name="AdvPersona" Style="{StaticResource Field}" Height="130"
                           AcceptsReturn="True" TextWrapping="Wrap"
                           VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                  <TextBlock Text="发送给模型的角色设定，改动后点下方保存生效"
                             FontSize="10.5" Foreground="{StaticResource B.Faint}" Margin="0,8,0,0" />
                </StackPanel>
              </Border>

              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20,18" Margin="0,0,6,0">
                  <StackPanel>
                    <TextBlock Text="上下文预算" Style="{StaticResource SectionTitle}" />
                    <Grid Margin="0,0,0,10">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="输入上限" Style="{StaticResource FieldCaption}" />
                      <TextBox x:Name="AdvBudgetIn" Grid.Column="1" Style="{StaticResource Field}"
                               FontFamily="Consolas" Text="32000" />
                    </Grid>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="输出上限" Style="{StaticResource FieldCaption}" />
                      <TextBox x:Name="AdvBudgetOut" Grid.Column="1" Style="{StaticResource Field}"
                               FontFamily="Consolas" Text="8000" />
                    </Grid>
                  </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20,18" Margin="6,0,0,0">
                  <StackPanel>
                    <TextBlock Text="控制 API 诊断" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal">
                      <Button x:Name="AdvDiag" Content="运行诊断" Style="{StaticResource PrimaryButton}" />
                      <TextBlock x:Name="AdvDiagText" Text="等待诊断…" FontSize="11"
                                 Foreground="{StaticResource B.Faint}" VerticalAlignment="Center" Margin="14,0,0,0" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </Grid>

              <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="AdvSave" Content="保存" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" />
                  <Button x:Name="AdvReset" Content="恢复默认" Style="{StaticResource GhostButton}" />
                  <TextBlock x:Name="AdvHint" Text="" FontSize="11"
                             Foreground="{StaticResource B.Faint}" VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- ===== 记忆页 ===== -->
          <Grid x:Name="PageMemory" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="显式记忆库" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource B.Text}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <TextBox x:Name="MemSearch" Grid.Column="1" Style="{StaticResource Field}" />
                <TextBlock x:Name="MemCount" Grid.Column="2" Text="0 条" FontSize="11"
                           Foreground="{StaticResource B.Faint}" VerticalAlignment="Center" Margin="14,0,0,0" />
              </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8">
              <ListBox x:Name="MemList" BorderThickness="0" Background="Transparent"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
              <Button x:Name="MemAdd" Content="+ 添加" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
              <Button x:Name="MemEdit" Content="编辑" Style="{StaticResource GhostButton}" Margin="0,0,8,0" />
              <Button x:Name="MemDelete" Content="删除" Style="{StaticResource DangerButton}" Margin="0,0,24,0" />
              <Button x:Name="MemImport" Content="导入" Style="{StaticResource GhostButton}" Margin="0,0,8,0" />
              <Button x:Name="MemExport" Content="导出" Style="{StaticResource GhostButton}" />
              <TextBlock x:Name="MemHint" Text="" FontSize="11"
                         Foreground="{StaticResource B.Faint}" VerticalAlignment="Center" Margin="16,0,0,0" />
            </StackPanel>
          </Grid>

          <!-- ===== 陪伴页 ===== -->
          <ScrollViewer x:Name="PageCompanion" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Border Style="{StaticResource Card}" Padding="20,18">
                <StackPanel>
                  <TextBlock Text="自主陪伴" Style="{StaticResource SectionTitle}" />
                  <CheckBox x:Name="CompEnable" Content="允许桌宠主动发起对话" Margin="0,0,0,14" />
                  <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="间隔（分钟）" Style="{StaticResource FieldCaption}" />
                    <TextBox x:Name="CompInterval" Grid.Column="1" Style="{StaticResource Field}"
                             FontFamily="Consolas" Text="15" />
                    <TextBlock Grid.Column="2" Text="两次主动搭话的最小间隔" FontSize="10.5"
                               Foreground="{StaticResource B.Faint}" VerticalAlignment="Center" Margin="12,0,0,0" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}" Padding="20,18" Margin="0,12,0,0">
                <StackPanel>
                  <TextBlock Text="活跃时段" Style="{StaticResource SectionTitle}" />
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="从" Style="{StaticResource FieldCaption}" Margin="0,0,8,0" />
                    <TextBox x:Name="CompStart" Style="{StaticResource Field}" Width="70"
                             FontFamily="Consolas" Text="8" />
                    <TextBlock Text="点到" Style="{StaticResource FieldCaption}" Margin="12,0,8,0" />
                    <TextBox x:Name="CompEnd" Style="{StaticResource Field}" Width="70"
                             FontFamily="Consolas" Text="23" />
                    <TextBlock Text="点" Style="{StaticResource FieldCaption}" Margin="8,0,0,0" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,12,0,0">
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="CompSave" Content="保存陪伴配置" Style="{StaticResource PrimaryButton}" />
                  <TextBlock x:Name="CompHint" Text="" FontSize="11"
                             Foreground="{StaticResource B.Faint}" VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>

          <!-- ===== 维护页 ===== -->
          <ScrollViewer x:Name="PageMaintenance" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Border Style="{StaticResource Card}" Padding="20,18">
                <StackPanel>
                  <TextBlock Text="旧数据清理" Style="{StaticResource SectionTitle}" />
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="清理早于（天数）" Style="{StaticResource FieldCaption}" Margin="0,0,12,0" />
                    <TextBox x:Name="MaintDays" Style="{StaticResource Field}" Width="90"
                             FontFamily="Consolas" Text="30" />
                    <Button x:Name="MaintClean" Content="执行清理" Style="{StaticResource DangerButton}" Margin="16,0,0,0" />
                    <TextBlock x:Name="MaintCleanHint" Text="等待操作…" FontSize="11"
                               Foreground="{StaticResource B.Faint}" VerticalAlignment="Center" Margin="14,0,0,0" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="20,18" Margin="0,0,6,0">
                  <StackPanel>
                    <TextBlock Text="配置备份" Style="{StaticResource SectionTitle}" />
                    <StackPanel Orientation="Horizontal">
                      <Button x:Name="MaintBackup" Content="备份配置" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" />
                      <Button x:Name="MaintRestore" Content="恢复配置" Style="{StaticResource GhostButton}" />
                    </StackPanel>
                    <TextBlock x:Name="MaintBackupHint" Text="无操作" FontSize="11"
                               Foreground="{StaticResource B.Faint}" Margin="0,10,0,0" />
                  </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="20,18" Margin="6,0,0,0">
                  <StackPanel>
                    <TextBlock Text="日志归档" Style="{StaticResource SectionTitle}" />
                    <Button x:Name="MaintArchive" Content="归档日志" Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left" />
                    <TextBlock x:Name="MaintArchiveHint" Text="无操作" FontSize="11"
                               Foreground="{StaticResource B.Faint}" Margin="0,10,0,0" />
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
          </ScrollViewer>

          <!-- ===== 日志页 ===== -->
          <Grid x:Name="PageLogs" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,12">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="日志文件" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource B.Text}" VerticalAlignment="Center" Margin="0,0,14,0" />
                <ComboBox x:Name="LogsPicker" Width="320" Height="32" FontSize="12" />
                <Button x:Name="LogsRefresh" Content="刷新" Style="{StaticResource GhostButton}" Margin="12,0,0,0" />
                <TextBlock x:Name="LogsHint" Text="" FontSize="11"
                           Foreground="{StaticResource B.Faint}" VerticalAlignment="Center" Margin="14,0,0,0" />
              </StackPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12">
              <ScrollViewer x:Name="LogsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <TextBlock x:Name="LogsText" FontFamily="Consolas" FontSize="11.5"
                           Foreground="{StaticResource B.Text}" TextWrapping="NoWrap" Text="选择一个日志文件" />
              </ScrollViewer>
            </Border>
          </Grid>

          <!-- ===== 关于页 ===== -->
          <ScrollViewer x:Name="PageAbout" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <Border Style="{StaticResource Card}" Padding="24,26">
                <StackPanel HorizontalAlignment="Center">
                  <Border Width="88" Height="88" CornerRadius="44" Background="{StaticResource B.Surface2}">
                    <Image x:Name="AboutLogo" Stretch="Uniform" Margin="2" />
                  </Border>
                  <TextBlock Text="大肥鱼桌宠" FontSize="20" FontWeight="SemiBold"
                             Foreground="{StaticResource B.Text}" HorizontalAlignment="Center" Margin="0,16,0,0" />
                  <TextBlock x:Name="AboutVersion" Text="v1.1.1" FontSize="12"
                             Foreground="{StaticResource B.Accent}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                  <TextBlock Text="DeepSeek 鲸鱼娘 · Live2D 桌面宠物" FontSize="11.5"
                             Foreground="{StaticResource B.Muted}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,12,0,0">
                <StackPanel>
                  <TextBlock Text="运行信息" Style="{StaticResource SectionTitle}" />
                  <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="启动器版本" Style="{StaticResource FieldCaption}" />
                    <TextBlock x:Name="AboutLauncher" Grid.Column="1" FontSize="11.5"
                               Foreground="{StaticResource B.Text}" FontFamily="Consolas" />
                  </Grid>
                  <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="界面框架" Style="{StaticResource FieldCaption}" />
                    <TextBlock Grid.Column="1" Text="WPF (.NET Framework 4.8)" FontSize="11.5"
                               Foreground="{StaticResource B.Text}" FontFamily="Consolas" />
                  </Grid>
                  <Grid Margin="0,0,0,7">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="安装目录" Style="{StaticResource FieldCaption}" />
                    <TextBlock x:Name="AboutRoot" Grid.Column="1" FontSize="11.5"
                               Foreground="{StaticResource B.Text}" FontFamily="Consolas" TextTrimming="CharacterEllipsis" />
                  </Grid>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="仓库" Style="{StaticResource FieldCaption}" />
                    <TextBlock Grid.Column="1" Text="github.com/1156269801-lang/desktop-pet-live2d"
                               FontSize="11.5" Foreground="{StaticResource B.Accent}" FontFamily="Consolas" />
                  </Grid>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,12,0,0">
                <StackPanel>
                  <TextBlock Text="致谢" Style="{StaticResource SectionTitle}" />
                  <TextBlock FontSize="11.5" Foreground="{StaticResource B.Muted}" TextWrapping="Wrap"
                             LineHeight="20">
                    Live2D Cubism SDK · Electron · GPT-SoVITS · SenseVoice (sherpa-onnx) · MediaPipe
                    · 界面设计参考 PCL2 / HMCL / UI UX Pro Max（仅参考，未复制代码）。
                    完整清单见仓库 THIRD_PARTY_NOTICES.md。
                  </TextBlock>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>

      <!-- ===== 底部状态栏 ===== -->
      <Border Grid.Row="2" Background="{StaticResource B.Accent}" Opacity="0.94">
        <Grid>
          <TextBlock x:Name="StatusText" Text="就绪" FontSize="11.5" Foreground="White"
                     VerticalAlignment="Center" Margin="22,0,0,0" />
          <TextBlock x:Name="StatusRight" Text="" FontSize="10.5" Foreground="#DCEBFB"
                     HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0" />
        </Grid>
      </Border>

      <Border x:Name="ResizeGrip" Grid.Row="2" Width="14" Height="14"
              HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Background="Transparent" Cursor="SizeNWSE" />
    </Grid>
  </Border>
</Window>
